#!/usr/bin/env bash
# pwa-starter: pre-commit @ d2fad01  (+ the prose lint)
# Warn-only pre-commit guard. Enable once per clone:
#   git config core.hooksPath .githooks
# Never blocks a commit — it nags. CI (.github/workflows/checks.yml) runs the lint + tests with
# real exit codes; the staged-diff checks (V bump, OG card size) only bite here.
python3 scripts/sw-lint.py || true
python3 scripts/og-lint.py || true

# Every number in README/CLAUDE.md the repo can compute, against the live value. It reads the
# working tree, so unlike the two BRANCH gates (fix-lint.py, ablate.py) it can answer here —
# those need both sides of a merge and run in CI only.
python3 scripts/prose-lint.py || true

# The data gate. Every serious defect this dataset has had was a plausible-looking wrong NUMBER
# that no test caught; validate.py compares composers.json against its schema, the other caches,
# and the previous commit. Warn-only here like the rest; CI runs it with a real exit code.
python3 scripts/validate.py || true

# Behavioral tests: the offline / lie-fi fetch-handler contract. Skipped quietly if node is
# absent (the toolchain is otherwise Python; node is only needed for these).
if command -v node >/dev/null 2>&1; then
  node scripts/sw.test.mjs >/dev/null 2>&1 || echo "  (warning only — sw tests failed; run 'node scripts/sw.test.mjs' to see why)"
fi
exit 0
